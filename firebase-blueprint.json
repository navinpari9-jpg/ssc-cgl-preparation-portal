{
  "entities": {
    "users": {
      "title": "User",
      "description": "Student and Admin user profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "targetExamYear": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "doubts": {
      "title": "StudentDoubt",
      "description": "Student doubt tickets and AI solutions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "question": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "question", "subject", "topic"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Collection of user profiles"
    },
    "/doubts/{doubtId}": {
      "schema": "doubts",
      "description": "Collection of student doubts"
    }
  }
}
